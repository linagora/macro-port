{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linagora/macro-port/schema/rules/complexity.schema.json",
  "title": "Macro-Port complexity levels and traits",
  "description": "rules/complexity.yaml: the metric conditions of the file complexity levels, the metrics they name and the traits (SPEC section 7). The definitions it shares with families.schema.json are identical.",
  "type": "object",
  "required": ["version", "file_levels", "metric_definitions", "traits"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "file_levels": {
      "type": "object",
      "required": ["medium", "high"],
      "additionalProperties": false,
      "properties": {
        "medium": { "$ref": "#/$defs/level" },
        "high": { "$ref": "#/$defs/level" }
      }
    },
    "metric_definitions": {
      "description": "The metrics that conditions can name, each with what it counts.",
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "traits": {
      "type": "array",
      "items": { "$ref": "#/$defs/trait" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "label": {
      "type": "object",
      "required": ["en", "fr"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "fr": { "type": "string", "minLength": 1 }
      }
    },
    "structural_predicate": {
      "description": "The closed list of SPEC section 7.",
      "enum": [
        "udf_candidate",
        "event_handler",
        "auto_exec",
        "chr_obfuscation",
        "long_hex_or_base64_literal",
        "nested_loop_compare",
        "possibly_unused",
        "parse_recovered"
      ]
    },
    "threshold": {
      "description": "A whole number that fits the core's 32 bits.",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "level": {
      "type": "object",
      "required": ["any"],
      "additionalProperties": false,
      "properties": {
        "any": {
          "description": "The level is reached when one of its conditions holds.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metric_condition" }
        }
      }
    },
    "metric_condition": {
      "description": "A metric of metric_definitions with exactly one bound: gte (at least) or lte (at most).",
      "type": "object",
      "required": ["metric"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "gte": { "$ref": "#/$defs/threshold" },
        "lte": { "$ref": "#/$defs/threshold" }
      },
      "oneOf": [{ "required": ["gte"] }, { "required": ["lte"] }]
    },
    "pattern_condition": {
      "description": "Regexes, as for the matcher of the same name (SPEC section 7).",
      "type": "object",
      "required": ["match", "pattern"],
      "additionalProperties": false,
      "properties": {
        "match": { "description": "comment or procedure_name, which condition checks." },
        "pattern": {
          "type": ["string", "array"],
          "minLength": 1,
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ratio_condition": {
      "description": "Holds when the occurrences of the members or chains of `of`, divided by the procedure's logical_loc, reach per_logical_loc_gte.",
      "type": "object",
      "required": ["match", "of", "per_logical_loc_gte"],
      "additionalProperties": false,
      "properties": {
        "match": { "description": "ratio, which condition checks." },
        "of": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "per_logical_loc_gte": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "condition": {
      "description": "A metric condition when it has no match, otherwise the condition that match names.",
      "properties": { "match": { "enum": ["comment", "procedure_name", "ratio"] } },
      "if": { "required": ["match"] },
      "then": {
        "if": { "properties": { "match": { "const": "ratio" } } },
        "then": { "$ref": "#/$defs/ratio_condition" },
        "else": { "$ref": "#/$defs/pattern_condition" }
      },
      "else": { "$ref": "#/$defs/metric_condition" }
    },
    "conditions": {
      "description": "At least one condition: an empty any would never hold, an empty all always would.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/condition" }
    },
    "trait": {
      "type": "object",
      "required": ["id", "label", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "description": { "type": "string", "minLength": 1 },
        "any": { "$ref": "#/$defs/conditions" },
        "all": { "$ref": "#/$defs/conditions" },
        "structural": { "$ref": "#/$defs/structural_predicate" }
      },
      "oneOf": [{ "required": ["any"] }, { "required": ["all"] }, { "required": ["structural"] }]
    }
  }
}
